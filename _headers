/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://identity.netlify.com https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.fbcdn.net https://*.facebook.com; font-src 'self' data:; connect-src 'self' https://*.facebook.com; frame-src 'self' https://www.facebook.com https://web.facebook.com; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

/admin/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://identity.netlify.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https://api.netlify.com https://api.github.com https://www.gravatar.com https://avatars.githubusercontent.com; frame-ancestors 'self'
